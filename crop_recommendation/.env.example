# Copy to .env and fill in the values.
SECRET_KEY=
DEBUG=True

# External APIs
GOOGLE_API_KEY=
OPENWEATHER_API_KEY=
ISDA_API_KEY=
GROQ_API_KEY=

# Database. Production (Supabase): paste the "Session pooler" connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local PostgreSQL alternative: USE_POSTGRES=True and the DB_* values. Otherwise SQLite.
USE_POSTGRES=False
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Set True once NIDA verification is integrated
REQUIRE_NIDA_VERIFICATION=False

# Port for `python manage.py runserver`
PORT=8765

# --- Production only (see DEPLOY.md) ---
# Public address of this backend, e.g. https://yourname-agrosmart-api.hf.space
# BACKEND_URL=
# Website address(es) allowed to call the API, comma-separated
# FRONTEND_URLS=https://agrosmart.vercel.app
# Optional: allow Vercel preview deployments too
# FRONTEND_URL_REGEX=^https://agrosmart-.*\.vercel\.app$
# Extra host names this backend answers to, comma-separated
# ALLOWED_HOSTS=
# Uploaded photos in Supabase Storage (Storage -> Settings -> S3 connection / access keys)
# SUPABASE_PROJECT_REF=
# SUPABASE_STORAGE_BUCKET=media
# SUPABASE_S3_REGION=
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# Admin account created on first start
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# Container web server: port (default 7860) and workers (each loads TensorFlow, ~1.5 GB of memory)
# WEB_PORT=7860
# WEB_WORKERS=2

# Google login: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Facebook login: developers.facebook.com > your app > Settings > Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Groq models (optional; change if Groq retires one). Defaults shown.
# CHAT_MODEL=openai/gpt-oss-120b
# MODERATION_MODEL=openai/gpt-oss-safeguard-20b
# MODERATION_FALLBACK_MODEL=openai/gpt-oss-20b
# IMAGE_MODERATION_MODEL=qwen/qwen3.8-27b
